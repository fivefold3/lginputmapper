{
  "name": "com.lginputmapper.app",
  "version": "1.0.0",
  "description": "LG Input Mapper - remap the buttons on your LG remote (rooted webOS)",
  "private": true,
  "scripts": {
    "build:daemon": "sh daemon/build.sh dist/service/bin",
    "build:web": "webpack --env production",
    "build": "npm run build:daemon && npm run build:web",
    "package": "ares-package -n -o dist dist/app dist/service",
    "deploy": "sh scripts/deploy.sh",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "dependencies": {
    "core-js": "^3.38.0",
    "webostvjs": "^1.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@webos-tools/cli": "^3.1.0",
    "babel-loader": "^9.2.0",
    "copy-webpack-plugin": "^12.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.0"
  }
}
